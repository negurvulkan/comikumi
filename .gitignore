# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# electron-builder packaging output
release/

# Local runtime data — global font/image/SVG library, thumbnail cache, and the
# "last opened project" pointer (app-state.json holds an absolute, machine-specific
# path). All of it is recreated on demand; see docs/FEATURES.md.
server/data/

# Playwright E2E — throwaway server/scan-root data + credentials generated by
# e2e/global-setup.ts, plus its own reports. Not dot-prefixed (see playwright.config.ts's
# TMP_DIR comment — Express's sendFile() 404s dot-prefixed path segments).
e2e/tmp-run/
e2e/test-results/
e2e/playwright-report/

# Throwaway inputs/diff output for pageRaster.visual.test.ts — only the checked-in
# baseline PNG itself belongs in git.
server/src/lib/__fixtures__/.tmp/

# Logs
*.log

# Env
.env
.env.*
!.env.example

